#!/bin/sh
# Forced command for the CI deploy key (authorized_keys: restrict,command="/usr/local/bin/bridgepay-deploy").
# Reads rendered manifests on stdin, applies them, waits for every rollout. SSH_ORIGINAL_COMMAND is ignored.
set -eu
export KUBECONFIG=/home/deploy/.kube/config
manifest=$(mktemp)
trap 'rm -f "$manifest"' EXIT
cat > "$manifest"
# Prune deletes labeled objects no longer in the manifests. Secrets (hand-made) and PVCs (data)
# are left off the allowlist on purpose: removing one of those stays a manual step.
kubectl apply -f "$manifest" --prune -l app.kubernetes.io/managed-by=bridgepay-ci \
  --prune-allowlist=core/v1/ConfigMap \
  --prune-allowlist=core/v1/Service \
  --prune-allowlist=core/v1/ServiceAccount \
  --prune-allowlist=apps/v1/Deployment \
  --prune-allowlist=batch/v1/CronJob \
  --prune-allowlist=networking.k8s.io/v1/Ingress \
  --prune-allowlist=networking.k8s.io/v1/NetworkPolicy \
  --prune-allowlist=rbac.authorization.k8s.io/v1/Role \
  --prune-allowlist=rbac.authorization.k8s.io/v1/RoleBinding \
  --prune-allowlist=traefik.io/v1alpha1/Middleware
for ns in platform bridgepay; do
  for d in $(kubectl -n "$ns" get deploy -o name); do
    kubectl -n "$ns" rollout status "$d" --timeout=600s
  done
done
echo "deploy ok"
